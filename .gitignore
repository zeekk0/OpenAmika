# ── Secrets: never commit ────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
brain/.env*
settings.json
config/tools.json
config/messengers.json

# ── Private runtime data (memories, usage ledger, logs, machine-local state) ──
memory_f/
brain/memories/
logs/
*.log
*.sqlite
*.sqlite-journal
config/seed.json
config/ollama.json
config/custom_models.json
config/voice_map.json
servers/openamika-iot/devices.json
servers/openamika-iot/scenes.json
avatar/stage/
tests/output/
controls_verification.json

# ── Python environments made by scripts/setup_core.py (venvs in envs\<name>) ──
envs/

# ── Large model weights and licensed assets (bring your own / download) ──
speech/models/*
!speech/models/DOWNLOAD.md
avatar/models/*
!avatar/models/README.md

# ── Third-party stacks you install next to OpenAmika (never part of this repo) ──
IoT/zigbee2mqtt/
IoT/data/
IoT/logs/
Hermes/
Nanomuse/
Vanadis_Evo/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.bak
*.tmp
*.orig

# ── Local TLS material ───────────────────────────────────────────────
certs/
*.pem
*.key

# voice server: only the server code and its docs are in git. scripts/setup_tts.py builds the rest
# (.venv/, GPT-SoVITS/, ffmpeg/, nltk_data/, Speakers/, cache/, downloads/) from public sources.
vendor/tts-engine/*
!vendor/tts-engine/main.py
!vendor/tts-engine/requirements-tts.txt
!vendor/tts-engine/README.md
!vendor/tts-engine/LICENSE
!vendor/tts-engine/THIRD_PARTY_NOTICES.md

# per-machine runtime state written by a custom-endpoint save in progress
config/custom_models.recovery.json
config/custom_models.json
